# Backend en Render: https://latin-zumi-back.onrender.com (sin /api-docs).
# Para correrlo en local: http://localhost:3000
# El backend solo acepta pedidos desde los orígenes de su CORS_ORIGINS: en local, Vite en el puerto 5173.
VITE_API_URL=https://latin-zumi-back.onrender.com
# true: datos de prueba en el navegador, sin backend. false: API real en VITE_API_URL
VITE_USE_MOCK=false

# Firebase Web app configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
